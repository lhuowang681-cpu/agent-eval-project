+  /** Reuse the existing model runtime only for explicitly configured judge rubrics. */
+  private async evaluateOutput(params: Parameters<typeof evaluate>[0], passThreshold: number) {
+    for (const rubric of params.rubrics) {
+      if (rubric.type !== 'llm-rubric' && rubric.type !== 'answer-relevance') continue;
+      const config = rubric.config as { model?: string; provider?: string };
+      if (
+        !config ||
+        typeof config.model !== 'string' ||
+        !config.model.trim() ||
+        typeof config.provider !== 'string' ||
+        !config.provider.trim()
+      ) {
+        throw new Error('LLM judge requires an explicit model and provider');
+      }
+    }
+
+    // Matchers return failed results on generation errors; retain the infrastructure
+    // error separately so the service can mark it error instead of a wrong answer.
+    let judgeError: Error | undefined;
+    const result = await evaluate(params, {
+      matchContext: {
+        generateObject: async (payload) => {
+          try {
+            const { initModelRuntimeFromDB } = await import('@/server/modules/ModelRuntime');
+            const runtime = await initModelRuntimeFromDB(this.db, this.userId, payload.provider!);
+            const output = await runtime.generateObject(
+              {
+                messages: payload.messages,
+                model: payload.model,
+                schema: {
+                  name: 'eval_judge_score',
+                  schema: payload.schema as GenerateObjectSchema['schema'],
+                },
+              },
+              { signal: AbortSignal.timeout(60_000) },
+            );
+            const value = output as { reason?: unknown; score?: unknown } | null;
+            if (
+              !value ||
+              typeof value.score !== 'number' ||
+              !Number.isFinite(value.score) ||
+              value.score < 0 ||
+              value.score > 1 ||
+              typeof value.reason !== 'string'
+            ) {
+              throw new Error('LLM judge returned an invalid score or reason');
+            }
+            return { reason: value.reason, score: value.score };
+          } catch (error) {
+            judgeError = error instanceof Error ? error : new Error('LLM judge generation failed');
+            throw judgeError;
+          }
+        },
+      },
+      passThreshold,
+    });
+    if (judgeError) throw judgeError;
+    return result;
+  }

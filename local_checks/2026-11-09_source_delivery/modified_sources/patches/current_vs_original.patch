+
+interface ServiceOptions extends PythonOptions {
+  runner?: (input: Trajectory, options: PythonOptions) => Promise<Diagnostic>;
+  now?: () => Date;
+  engineRevision?: string;
+}
+interface JobMetadata {
+  engineRevision: string;
+  input: Trajectory;
+  leaseToken?: string;
+  leaseStartedAt?: string;
+  result?: Diagnostic;
+}

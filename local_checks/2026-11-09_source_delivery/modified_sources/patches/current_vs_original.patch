+    arguments: null,
+    error: null,
+    traceId: 'trace-source',
+    sequence: 0,
+    createdAt: '2026-11-08T00:00:00Z',
+  };
+  const input: Trajectory = {
+    schemaVersion: 1,
+    trajectoryId: 'eval:run:case:topic:main',
+    inputDigest: 'pending',

+    let release: (output: Diagnostic) => void = () => {
+      throw new Error('First runner not started');
+    };
+    let started: () => void = () => {};
+    const start = new Promise<void>((resolve) => {
+      started = resolve;
+    });
+    let captured: Trajectory | undefined;

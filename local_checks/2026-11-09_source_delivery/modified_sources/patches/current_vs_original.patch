+
+  it.each([1e-4, 1e-5, 1e20, 1e21, -1e-5, -1e-7, 1.2e-4, 1.23e22])('aligns actual Python evidence at numeric formatting boundary %s', async (value: number) => {
+    const input = trajectoryFixture();

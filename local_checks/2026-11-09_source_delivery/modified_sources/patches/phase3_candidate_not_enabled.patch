+def cited_category(node, field, quote):
+    """Check only the cited failure-bearing field, not another field on its node.
+
+    A nested business result is not an execution failure envelope. The original
+    node remains authoritative; this copy cannot add facts or establish ownership.
+    """
+    if field not in {'content', 'error'}:
+        return None
+    cited = {**node, 'content': quote if field == 'content' else '', 'error': None}
+    try:
+        decoded = json.loads(quote)
+    except (ValueError, TypeError):
+        decoded = quote
+    if field == 'error':
+        cited['error'] = decoded
+    elif isinstance(decoded, dict):
+        flags = {key.lower(): value for key, value in decoded.items()}
+        if flags.get('success') is True or flags.get('ok') is True:
+            return None
+        failed = (flags.get('success') is False or flags.get('ok') is False
+                  or flags.get('is_error') is True or flags.get('iserror') is True
+                  or str(flags.get('status', flags.get('currentstatus', ''))).lower()
+                  in {'failed', 'error', 'failure', 'aborted', 'rejected'})
+        if not failed:
+            return None
+    return observed_category(cited)
 
 

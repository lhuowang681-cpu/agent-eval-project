{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-eval:shadow-semantic-candidate:v1",
  "title": "Independent semantic candidate v1; runtime semantic_review.py is authoritative",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "scope", "inputDigest", "decision", "observations"],
  "properties": {
    "schemaVersion": {"const": 1},
    "scope": {"type": "object", "description": "Exact original Run/Case/Topic/Thread/Operation/Trace scope; never model-created"},
    "inputDigest": {"type": "string", "minLength": 1},
    "decision": {"enum": ["candidates", "abstain", "unknown", "needs_review"]},
    "observations": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/observation"}}
  },
  "allOf": [{"if": {"properties": {"decision": {"enum": ["abstain", "unknown"]}}}, "then": {"properties": {"observations": {"maxItems": 0}}}}],
  "$defs": {
    "scalar": {"type": ["string", "number", "boolean", "null"]},
    "observation": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "category", "claimLevel", "summary", "evidenceRefs", "comparison"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "category": {"enum": ["parameter_task_mismatch", "answer_tool_mismatch", "stale_information_use"]},
        "claimLevel": {"enum": ["observation", "impact_hypothesis", "root_cause"]},
        "summary": {"type": "string", "maxLength": 1000},
        "comparison": {
          "type": "object", "additionalProperties": false, "required": ["key", "expected", "actual"],
          "properties": {"key": {"type": "string", "minLength": 1, "description": "A single Python identifier; no dotted/index paths"}, "expected": {"$ref": "#/$defs/scalar"}, "actual": {"$ref": "#/$defs/scalar"}}
        },
        "evidenceRefs": {
          "type": "array", "minItems": 1, "maxItems": 12,
          "items": {"type": "object", "additionalProperties": false, "required": ["nodeId", "field", "quote"], "properties": {"nodeId": {"type": "string"}, "field": {"enum": ["content", "arguments", "error"]}, "quote": {"type": "string", "minLength": 1, "maxLength": 2000}}}
        }
      }
    }
  }
}
